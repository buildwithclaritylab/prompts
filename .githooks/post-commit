#!/bin/sh
# Create a Git tag for each committed release.
# Author: AMU-Chatia, lun 12/oct/2026
# Modif: AMU-Chatia, vie 30/oct/2026
# Standardized release tagging for preview and main.
# The approved release tag is preserved when promoted to production.

release_id=$(node -p "require('./package.json').releaseId") || exit 1

if [ -z "$release_id" ]; then
    echo "Release ID is empty. Git tag was not created." >&2
    exit 1
fi

git tag -a "$release_id" -m "Release $release_id"